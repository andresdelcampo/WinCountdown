<configuration>
  <appSettings>
    <add key="InitialHours" value="0"/>
    <add key="InitialMinutes" value="0"/>
    <add key="InitialSeconds" value="5"/>

    <add key="Beep" value="false"/>
    <add key="SecondsOnZero" value="15"/>
    <add key="CountNegative" value="true"/>
  </appSettings>
</configuration>